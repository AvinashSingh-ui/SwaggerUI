{
  "openapi": "3.0.0",
  "info": {
    "title": "Product Management API",
    "version": "1.0.0",
    "description": "Product CRUD API documentation"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/products": {
      "get": {
        "operationId": "getProducts",
        "summary": "Get all products",
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter products by name"
          }
        ],
        "responses": {
          "200": {
            "description": "Products fetched successfully"
          }
        }
      },
      "post": {
        "operationId": "createProduct",
        "summary": "Create a product",
        "tags": [
          "Products"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "price",
                  "image"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Wireless Headphones"
                  },
                  "price": {
                    "type": "number",
                    "example": 2499
                  },
                  "image": {
                    "type": "string",
                    "example": "https://images.pexels.com/photos/3394650/pexels-photo-3394650.jpeg"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created successfully"
          },
          "400": {
            "description": "Name, price and image are required"
          }
        }
      }
    },
    "/api/products/{id}": {
      "put": {
        "operationId": "updateProduct",
        "summary": "Update a product",
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "price",
                  "image"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Smart Watch"
                  },
                  "price": {
                    "type": "number",
                    "example": 3999
                  },
                  "image": {
                    "type": "string",
                    "example": "https://images.pexels.com/photos/437037/pexels-photo-437037.jpeg"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product updated successfully"
          },
          "400": {
            "description": "Name, price and image are required"
          },
          "404": {
            "description": "Product not found"
          }
        }
      },
      "delete": {
        "operationId": "deleteProduct",
        "summary": "Delete a product",
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product deleted successfully"
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}